# ==========================================
# LegalMetrix Environment Configuration
# ==========================================

# Port (optional, default 3000)
PORT=3000

# Base URL for local application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------
# Vision AI / OCR APIs (At least one recommended for live AI extraction)
# ------------------------------------------
# Google Gemini API Key (Recommended for vision label extraction)
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key (Alternative vision extraction)
# Get key from: https://platform.openai.com/
OPENAI_API_KEY=

# ------------------------------------------
# Supabase PostgreSQL & Storage (Optional: Falls back to local persistent store if empty)
# ------------------------------------------
# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anonymous Public Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (Used on server-side for admin database operations)
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket name for package label images (default: package-labels)
SUPABASE_STORAGE_BUCKET=package-labels

# ------------------------------------------
# Application Features & Defaults
# ------------------------------------------
# Default Demo Mode: 'true' to highlight sample commodities, 'false' for clean production view
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
